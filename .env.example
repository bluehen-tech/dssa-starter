# Copy this file to .env.local and paste your values after the = signs.
# .env.local is never committed. Stage 5 of the Builder Path uses these.

# Supabase > Project Settings > API Keys > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Project Settings > API Keys > publishable key (older projects call it the anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
